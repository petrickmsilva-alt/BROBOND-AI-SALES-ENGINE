          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Lead Webhook').item.json.token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "qualify-lead",
      "name": "Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [[{ "node": "Create Lead", "type": "main", "index": 0 }]]
