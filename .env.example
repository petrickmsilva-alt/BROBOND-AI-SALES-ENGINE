# ---------------------------------------------------------------------------
# BROBOND AI SALES ENGINE - environment template
# Copy to .env and adjust before running `docker compose up`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="BROBOND AI Sales Engine"
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Exposed host ports
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678
OLLAMA_PORT=11434

# PostgreSQL 16
POSTGRES_USER=brobond
POSTGRES_PASSWORD=brobond
POSTGRES_DB=brobond
DATABASE_URL=postgresql+asyncpg://brobond:brobond@postgres:5432/brobond
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis 7
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# n8n
N8N_BASE_URL=http://n8n:5678
N8N_HOST=localhost
N8N_DB=n8n
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

# Authentication (JWT) - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
API_INTERNAL_URL=http://api:8000

# Misc
TZ=UTC
